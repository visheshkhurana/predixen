# =============================================================================
# FounderConsole — Railway service variables
# Paste this whole file into the app service's Variables tab -> "Raw Editor"
# on Railway, then fill in the blanks. Lines with ${{...}} are Railway
# references that resolve automatically once Postgres/Redis exist in the project.
# =============================================================================

# ---- Wiring (leave as-is) ---------------------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
PORT=5000
FASTAPI_PORT=8001
NODE_ENV=production
ENVIRONMENT=production

# ---- Core app ---------------------------------------------------------------
# JWT signing secret. Generate: openssl rand -hex 48
SECRET_KEY=

# Set to your real domain once DNS is cut over; use the *.up.railway.app URL while testing
APP_BASE_URL=https://founderconsole.ai
CORS_ORIGINS=https://founderconsole.ai

# Email address granted platform-admin access
ADMIN_MASTER_EMAIL=

# bcrypt hash for admin master password
# Generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_MASTER_PASSWORD_HASH=

# Credential-encryption salt — set once, never change after first boot
# Generate: openssl rand -hex 16
ENCRYPTION_SALT=

# ---- First-boot behaviour (fresh database) ----------------------------------
# Leave true for the first deploy so the schema is created; flip both to false after
CREATE_SCHEMA=true
RUN_MIGRATIONS=true
SEED_BENCHMARKS=true
SEED_DEMO_DATA=false

# ---- AI providers (your own keys — Replit-managed keys won't work) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=

# ---- Email / SMS / notifications -------------------------------------------
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SLACK_SIGNUP_WEBHOOK_URL=

# ---- Analytics / misc (optional) --------------------------------------------
VITE_POSTHOG_KEY=
NOTION_API_KEY=

# ---- Stripe (leave empty until you turn the paywall on) ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Tuning (defaults are fine) ---------------------------------------------
LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_ADMIN_LOGIN=3
RATE_LIMIT_API=60
RATE_LIMIT_UPLOAD=5
