# =============================================================================
# FounderConsole — production environment for docker-compose
# Copy to the repo root as `.env.production` on the VPS and fill in values.
#   cp deploy/env.production.example .env.production
# NEVER commit the filled-in file (already gitignored via .env.*).
# =============================================================================

# ---- Infrastructure (used by docker-compose itself) -------------------------
# Your domain, no protocol. Caddy gets TLS certificates for it automatically.
DOMAIN=founderconsole.ai

# Postgres password (also composed into DATABASE_URL for the app).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Core app ---------------------------------------------------------------
# JWT signing secret. Generate: openssl rand -hex 48
SECRET_KEY=

# Base URL used in emails and OG cards
APP_BASE_URL=https://founderconsole.ai

CORS_ORIGINS=https://founderconsole.ai

# Email address granted platform-admin access (and /admin/growth etc.)
ADMIN_MASTER_EMAIL=

# bcrypt hash for admin master password
# Generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
ADMIN_MASTER_PASSWORD_HASH=

# Credential-encryption salt — set once, never change after first boot
# Generate: openssl rand -hex 16
ENCRYPTION_SALT=

# ---- First-boot behaviour (fresh database) ----------------------------------
# Leave true for the first boot so the schema is created, then you can set
# CREATE_SCHEMA=false and RUN_MIGRATIONS=false and `docker compose up -d` again.
CREATE_SCHEMA=true
RUN_MIGRATIONS=true
SEED_BENCHMARKS=true
SEED_DEMO_DATA=false

# ---- AI providers (bring your own keys — Replit-managed keys won't work) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=

# ---- Email / SMS / notifications -------------------------------------------
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SLACK_SIGNUP_WEBHOOK_URL=

# ---- Analytics / misc (optional) --------------------------------------------
VITE_POSTHOG_KEY=
NOTION_API_KEY=

# ---- Stripe (leave empty until you turn the paywall on) ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Tuning (defaults are fine) ---------------------------------------------
LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_ADMIN_LOGIN=3
RATE_LIMIT_API=60
RATE_LIMIT_UPLOAD=5
