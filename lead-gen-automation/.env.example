# FounderConsole n8n environment variables
# Copy to your n8n .env (or paste into n8n Settings → Environment Variables)
# Fill in the values before running the workflow

# ============================================================
# LINKEDIN (for Apify Sales Nav scraper)
# ============================================================
# Get this from Chrome DevTools → Application → Cookies → linkedin.com → li_at
LINKEDIN_LI_AT=

# ============================================================
# GOOGLE (handled via OAuth — no keys needed here)
# Google Sheets / Gmail / Calendar / Docs all use OAuth credentials in n8n UI
# But you may want these for reference:
# ============================================================
# GOOGLE_PROSPECTS_SHEET_ID=         # the Google Sheet ID for Prospects
# GOOGLE_KB_PRODUCT_DOC_ID=          # Google Doc IDs for 4 KB docs
# GOOGLE_KB_PRICING_DOC_ID=
# GOOGLE_KB_OBJECTIONS_DOC_ID=
# GOOGLE_KB_ONBOARDING_DOC_ID=

# ============================================================
# APIFY (LinkedIn scraping)
# https://apify.com/settings/integrations
# ============================================================
APIFY_API_TOKEN=

# ============================================================
# PERPLEXITY (enrichment research)
# https://perplexity.ai/settings/api
# ============================================================
PERPLEXITY_API_KEY=

# ============================================================
# HUNTER.IO (email verification)
# https://hunter.io/api
# ============================================================
HUNTER_API_KEY=

# ============================================================
# PROSPEO (email finder — primary)
# https://prospeo.io
# ============================================================
PROSPEO_API_KEY=

# ============================================================
# SKRAPP (email finder — fallback)
# https://skrapp.io
# ============================================================
SKRAPP_API_KEY=

# ============================================================
# OPENAI (all LLM nodes)
# https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=

# Optional: also set these if you want to use the backup models in some chains
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ============================================================
# AIRTABLE (CRM)
# https://airtable.com/create/tokens
# ============================================================
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# ============================================================
# FOUNDERCONSOLE BACKEND (for activation webhook)
# Your FounderConsole backend posts to this n8n webhook on signup
# The URL is generated by n8n once the Signup Webhook node is activated
# ============================================================
# Example: https://your-n8n.example.com/webhook/founderconsole-signup
# Add this URL to your FounderConsole backend's signup handler

# ============================================================
# ALERTS (optional)
# ============================================================
# SLACK_WEBHOOK_LEADS=     # #leads channel for reply notifications
# SLACK_WEBHOOK_ALERTS=    # #alerts for errors
